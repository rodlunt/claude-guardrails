# Secrets and credentials: never commit plaintext secrets
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
credentials.json
service-account*.json

# Claude Code writes this at runtime; the policy in claude-core/ is the source
settings.json
settings.local.json

# OS and editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# Python bytecode, e.g. from `python3 -m py_compile` in CI or a local test run
__pycache__/
*.py[cod]
